rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidIata(code) {
      return code is string && code.size() == 3 && code.matches('^[A-Z]{3}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'homeAirportCode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'homeAirportCode', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && isValidIata(data.homeAirportCode)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation blueprint: FocusSession
    function isValidFocusSession(data, userId, sessionId) {
      return data.keys().hasAll([
          'id', 'userId', 'originCode', 'originCity',
          'destinationCode', 'destinationCity', 'destinationCountry',
          'destinationType', 'vehicleType',
          'subject', 'flightNumber', 'plannedMinutes', 'completedMinutes',
          'distanceKm', 'status', 'startedAt', 'endedAt', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'originCode', 'originCity',
          'destinationCode', 'destinationCity', 'destinationCountry',
          'destinationType', 'vehicleType',
          'subject', 'flightNumber', 'plannedMinutes', 'completedMinutes',
          'distanceKm', 'status', 'startedAt', 'endedAt', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == sessionId
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidIata(data.originCode)
        && data.originCity is string && data.originCity.size() >= 1 && data.originCity.size() <= 80
        && isValidIata(data.destinationCode)
        && data.destinationCity is string && data.destinationCity.size() >= 1 && data.destinationCity.size() <= 80
        && data.destinationCountry is string && data.destinationCountry.size() >= 1 && data.destinationCountry.size() <= 80
        && data.destinationType is string && data.destinationType in ['city', 'island', 'space']
        && data.vehicleType is string && data.vehicleType in ['jet', 'propeller', 'balloon', 'concorde']
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 140
        && data.flightNumber is string && data.flightNumber.size() >= 2 && data.flightNumber.size() <= 16
        && data.plannedMinutes is number && data.plannedMinutes >= 1 && data.plannedMinutes <= 720
        && data.completedMinutes is number && data.completedMinutes >= 0 && data.completedMinutes <= 720
        && data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 25000
        && data.status is string && data.status in ['completed', 'cancelled']
        && data.startedAt is string && data.startedAt.size() >= 10 && data.startedAt.size() <= 40
        && data.endedAt is string && data.endedAt.size() >= 10 && data.endedAt.size() <= 40
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'homeAirportCode', 'updatedAt']);

      allow delete: if false;

      match /sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isEmailVerified()
          && isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidFocusSession(incoming(), userId, sessionId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if false;

        allow delete: if isEmailVerified()
          && isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
